# Optional environment-based configuration.
# Everything below can instead be entered/saved through the UI, which stores it
# in the SQLite database (.data/telebucket.db).
#
# If you set these, the matching value is used (env wins over the DB).

# Telegram app credentials from https://my.telegram.org (create an app).
# Set these (or save them through the UI once) to provision the instance.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef